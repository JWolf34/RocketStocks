# Discord
DISCORD_TOKEN=your_discord_bot_token

# Schwab API
SCHWAB_API_KEY=your_schwab_api_key
SCHWAB_API_SECRET=your_schwab_api_secret

# Tiingo
TIINGO_API_KEY=your_tiingo_api_key

# News API
NEWS_API_KEY=your_news_api_key

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=rocketstocks
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional API keys
NASDAQ_API_KEY=
EODHD_API_TOKEN=
DOLTHUB_API_TOKEN=

# Config
NOTIFICATION_FILTER=all
TZ=America/Chicago

# --- v2 (burn-in coexistence: v2 never reads the v1 variables above) ---
# Compose-owned TimescaleDB password (S006): docker-compose.v2.yml composes
# the in-network RS_DB_URL from it. Keep it consistent with RS_DB_URL below.
RS_DB_PASSWORD=your_v2_db_password
# Host-side DSN for local tools (pytest helpers, rs_migrate, psql) reaching
# the compose DB on 127.0.0.1:5498
RS_DB_URL=postgresql+psycopg://postgres:your_v2_db_password@localhost:5498/rocketstocks
# Per-service database roles (created by `rs_migrate upgrade` / `rs_migrate roles`);
# at least 16 characters of A-Z a-z 0-9 . _ ~ - (compose puts them in DSNs
# unencoded). Generate each with: openssl rand -hex 24
RS_DB_PASSWORD_INGEST=generate_me
RS_DB_PASSWORD_BOT=generate_me
RS_DB_PASSWORD_SERVE=generate_me
RS_DB_PASSWORD_RESEARCH=generate_me
# Bot daemon (S004; operator checklist §4) — deliberately NOT v1's DISCORD_TOKEN
RS_BOT_DISCORD_TOKEN=your_v2_dev_bot_token
RS_BOT_ALERT_CHANNEL_ID=your_private_alert_channel_id
# Your Discord user id: may run /setup schwab and gets the token-expiry DMs (unset: guild owner only)
# RS_BOT_ADMIN_USER_ID=
# RS_BOT_SWEEP_SECONDS=60
# Ingest (required): the identity EDGAR requires on every request
RS_EDGAR_USER_AGENT=RocketStocks you@example.com
# Private Discord channel webhook for ops notices (notify_ops); unset = notices only logged
# RS_OPS_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# RS_LOG_FORMAT=auto        # json | console | auto (TTY→console, else json)
# RS_LOG_LEVEL=INFO
# DSN of the read-only rs_research role: ingest's weekly base-rate job passes it to
# `python -m rs_research event-study attention_surge`, which refuses RS_DB_URL.
# Compose builds it from RS_DB_PASSWORD_RESEARCH; set it here to run the study from the host.
# RS_RESEARCH_DB_URL=postgresql+psycopg://rs_research:<password>@localhost:5498/rocketstocks
# RS_INGEST_METRICS_PORT=9090
# RS_BOT_METRICS_PORT=9091
