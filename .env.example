# Every variable docker-compose.yml reads or the services accept is listed
# here. Uncommented lines are required; commented lines are optional and show
# the default.

# --- Schwab ---
SCHWAB_API_KEY=your_schwab_api_key
SCHWAB_API_SECRET=your_schwab_api_secret

# --- Database ---
# Compose-owned TimescaleDB password (the superuser; only the migrate gate uses it).
# docker-compose.yml composes the in-network RS_DB_URL from it.
# Keep it consistent with RS_DB_URL below.
RS_DB_PASSWORD=your_db_password
# Host-side DSN for local tools (pytest helpers, rs_migrate, rs_backfill, psql)
# reaching the compose DB on 127.0.0.1:5498
RS_DB_URL=postgresql+psycopg://postgres:your_db_password@localhost:5498/rocketstocks
# Per-service database roles (created by `rs_migrate upgrade` / `rs_migrate roles`);
# at least 16 characters of A-Z a-z 0-9 . _ ~ - (compose puts them in DSNs
# unencoded). Generate each with: openssl rand -hex 24
RS_DB_PASSWORD_INGEST=generate_me
RS_DB_PASSWORD_BOT=generate_me
RS_DB_PASSWORD_MCP=generate_me
RS_DB_PASSWORD_RESEARCH=generate_me
# The research role is read-only; nothing runs as it yet (a later read-only MCP server may).

# --- Ingest ---
# Required: the identity EDGAR requires on every request
RS_EDGAR_USER_AGENT=RocketStocks you@example.com
# Must match the callback URL registered with the Schwab app
# SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
# How often (seconds) a dead Schwab token is checked for renewal
# RS_INGEST_TOKEN_POLL_SECONDS=60
# Fallback poll (seconds) for /setup schwab requests; NOTIFY normally wakes the handler at once
# RS_INGEST_AUTH_POLL_SECONDS=15
# Seconds SIGTERM waits for in-flight jobs; compose stop_grace_period (45s) must exceed it
# RS_INGEST_SHUTDOWN_GRACE_SECONDS=30
# Schwab calls per minute shared by every Schwab job
# RS_INGEST_SCHWAB_CALLS_PER_MINUTE=100
# Healthcheck: fail when the daemon loop heartbeat is older than this many seconds
# RS_INGEST_HEALTH_MAX_AGE_SECONDS=120
# Metrics side-port; compose publishes 9090, so change it only for host-side runs
# RS_INGEST_METRICS_PORT=9090

# --- Bot ---
RS_BOT_DISCORD_TOKEN=your_discord_bot_token
RS_BOT_ALERT_CHANNEL_ID=your_private_alert_channel_id
# Your Discord user id. Set it in production: it may run /setup schwab and gets the
# token-age DMs. Unset, only the guild owner may run /setup schwab and the DMs go to
# the Discord application's owner, who may be someone else.
# RS_BOT_ADMIN_USER_ID=
# Seconds between sweeps for unposted alerts (bounds a lost NOTIFY)
# RS_BOT_SWEEP_SECONDS=60
# Failed sends allowed per alert before it is abandoned and the operator is pinged
# RS_BOT_POST_MAX_ATTEMPTS=5
# Metrics side-port; compose publishes 9091, so change it only for host-side runs
# RS_BOT_METRICS_PORT=9091

# --- Ops pings and logging (ingest and bot) ---
# Private Discord channel webhook for Ops pings (notify_ops); unset = pings only logged
# A source (ApeWisdom, Schwab, Nasdaq, EDGAR, Discord) pings once when it starts failing and once when it clears
# RS_OPS_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Seconds during which a repeated ping with the same key is suppressed
# RS_OPS_DEDUP_WINDOW_SECONDS=900
# Webhook request timeout in seconds
# RS_OPS_TIMEOUT_SECONDS=5
# RS_LOG_FORMAT=auto        # json | console | auto (TTY->console, else json)
# RS_LOG_LEVEL=INFO
