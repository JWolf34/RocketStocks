# Discord
DISCORD_TOKEN=your_discord_bot_token

# Schwab API
SCHWAB_API_KEY=your_schwab_api_key
SCHWAB_API_SECRET=your_schwab_api_secret

# Tiingo
TIINGO_API_KEY=your_tiingo_api_key

# News API
NEWS_API_KEY=your_news_api_key

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=rocketstocks
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional API keys
NASDAQ_API_KEY=
EODHD_API_TOKEN=
DOLTHUB_API_TOKEN=

# Config
NOTIFICATION_FILTER=all
TZ=America/Chicago

# --- v2 (burn-in coexistence: v2 never reads the v1 variables above) ---
# Shared DSN (ingest, bot, rs_migrate)
RS_DB_URL=postgresql+psycopg://user:password@localhost:5498/rocketstocks
# Bot daemon (S004; operator checklist §4) — deliberately NOT v1's DISCORD_TOKEN
RS_BOT_DISCORD_TOKEN=your_v2_dev_bot_token
RS_DEV_CHANNEL_ID=your_private_dev_channel_id
# RS_BOT_SWEEP_SECONDS=60
